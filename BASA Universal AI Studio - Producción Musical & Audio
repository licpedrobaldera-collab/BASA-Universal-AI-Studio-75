    function sendTrackToRemix(trackId) {
      switchWorkspaceTab('create');
      setCreationMode('remix');
      document.getElementById('remix-source-select').value = trackId;
      loadRemixSourcePreview();
      showToast('Pista cargada en el motor de Remix.', 'info');
    }

    function deleteTrack(trackId) {
      if (libraryTracks.length <= 1) {
        showToast('Debe permanecer al menos una pista en la biblioteca.', 'warn');
        return;
      }
      if (currentTrackId === trackId) {
        stopPlayback();
      }
      libraryTracks = libraryTracks.filter(t => t.id !== trackId);
      saveLibraryToStorage();
      renderLibrary();
      if (currentTrackId === trackId) {
        selectTrackForPlayer(libraryTracks[0].id, false);
      }
      showToast('Pista eliminada de la biblioteca.', 'info');
    }

    /**
     * ============================================================================
     * MODAL DE LETRAS Y FICHA TÉCNICA
     * ============================================================================
     */
    function openLyricsModal(trackId) {
      const track = libraryTracks.find(t => t.id === trackId);
      if (!track) return;
      modalInspectedTrack = track;

      document.getElementById('modal-track-title').textContent = track.title;
      document.getElementById('modal-track-subtitle').textContent = `${track.genre} • ${track.bpm} BPM • Tonalidad ${track.key} • ${track.model}`;
      document.getElementById('modal-track-lyrics').textContent = track.lyrics;

      const instBox = document.getElementById('modal-track-instruments');
      instBox.innerHTML = track.instruments
        .map(i => `<span class="px-2.5 py-0.5 rounded-full bg-[#E0F2FE] text-[#0284C7] text-xs font-bold">${i}</span>`)
        .join('');

      const modal = document.getElementById('lyrics-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
