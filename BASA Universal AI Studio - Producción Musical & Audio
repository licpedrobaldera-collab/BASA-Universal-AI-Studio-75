<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BASA Universal AI Studio — Módulo de Producción Musical & Audio</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            basaBg: '#F1F5F9',
            basaCard: '#FFFFFF',
            basaBorder: '#CBD5E1',
            basaSkySoft: '#E0F2FE',
            basaSkyMid: '#38BDF8',
            basaSkyDark: '#0284C7',
            basaText: '#0F172A',
          }
        }
      }
    }
  </script>

  <style>
    /* Estilos base y scrollbar limpio para el entorno Studio */
    body {
      background-color: #F1F5F9;
      color: #0F172A;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* Scrollbars sutiles */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #F1F5F9;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    /* Range inputs personalizados */
    input[type="range"] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 6px;
      background: #E0F2FE;
      border: 1px solid #BAE6FD;
      border-radius: 9999px;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 16px;
      width: 16px;
      border-radius: 50%;
      background: #0284C7;
      border: 2px solid #FFFFFF;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.3);
      margin-top: -6px;
      cursor: pointer;
    }

    @keyframes pulseSoft {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }
    .animate-pulse-soft {
      animation: pulseSoft 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#F1F5F9] text-[#0F172A] overflow-x-hidden">

  <!-- NOTIFICACIÓN TOAST FLOTANTE (Reemplaza alert/confirm) -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-4 sm:px-0"></div>

  <!-- 1. BARRA SUPERIOR (HEADER) -->
  <header class="bg-white border-b border-[#CBD5E1] sticky top-0 z-30 shadow-xs">
    <div class="max-w-[1600px] mx-auto px-3 sm:px-5 py-2.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Branding y Estado del Motor -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#E0F2FE] border border-[#38BDF8] flex items-center justify-center text-[#0284C7] shadow-xs shrink-0">
          <i class="fa-solid fa-wave-square text-lg"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-extrabold text-base sm:text-lg tracking-tight text-black leading-none">
              BASA Universal Studio
            </h1>
            <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#E0F2FE] text-[#0284C7] border border-[#BAE6FD]">
              <span class="w-2 h-2 rounded-full bg-[#0284C7] animate-pulse-soft"></span>
              Motor WebAudio Activo
            </span>
          </div>
          <p class="text-xs text-slate-600 font-medium mt-0.5">Módulo de Producción Musical &amp; Síntesis IA</p>
        </div>
      </div>

      <!-- Selector de Modelo IA y Botones de Exportación -->
      <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
        <!-- Selector Modelo IA -->
        <div class="flex items-center gap-2 bg-[#F8FAFC] border border-[#CBD5E1] rounded-xl px-2.5 py-1.5">
          <i class="fa-solid fa-microchip text-[#0284C7] text-xs"></i>
          <label for="ai-model-select" class="text-xs font-semibold text-slate-700 hidden md:inline">Motor IA:</label>
          <select id="ai-model-select" onchange="updateModelBadge()" class="bg-transparent text-xs sm:text-sm font-bold text-black focus:outline-none cursor-pointer">
            <option value="BASA-Audio-V10 Pro">BASA-Audio-V10 Pro</option>
            <option value="BASA-Típico-Engine">BASA-Típico-Engine (RD/Caribe)</option>
            <option value="BASA-Vocal-Master">BASA-Vocal-Master HD</option>
            <option value="BASA-Acústico-Bolero">BASA-Acústico-Bolero</option>
          </select>
        </div>

        <!-- Botones de Exportación -->
        <div class="flex items-center gap-1.5">
          <button onclick="exportProjectJSON()" title="Exportar Proyecto Completo JSON" class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-[#E0F2FE] text-black border border-[#CBD5E1] hover:border-[#38BDF8] text-xs font-semibold transition flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-file-code text-[#0284C7]"></i>
            <span class="hidden lg:inline">Proyecto JSON</span>
          </button>
          <button onclick="downloadLyricsTXT()" title="Descargar Letra en TXT" class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-[#E0F2FE] text-black border border-[#CBD5E1] hover:border-[#38BDF8] text-xs font-semibold transition flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-file-lines text-[#0284C7]"></i>
            <span class="hidden lg:inline">Letra TXT</span>
          </button>
          <button onclick="exportPromptScript()" title="Copiar Guion / Prompt de Producción" class="px-2.5 py-1.5 rounded-xl bg-[#E0F2FE] hover:bg-[#BAE6FD] text-[#0284C7] border border-[#38BDF8] text-xs font-bold transition flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-copy"></i>
            <span>Guion/Prompt</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- CONTENEDOR PRINCIPAL DEL ESTUDIO -->
  <div class="flex-1 max-w-[1600px] w-full mx-auto flex flex-col lg:flex-row gap-4 p-3 sm:p-4 pb-36">
    
    <!-- 2. BARRA DE NAVEGACIÓN LATERAL COMPACTA -->
    <nav aria-label="Navegación del Estudio" class="bg-white border border-[#CBD5E1] rounded-2xl p-2 flex lg:flex-col justify-between lg:justify-start gap-1.5 lg:w-52 shrink-0 shadow-xs overflow-x-auto">
      <button onclick="switchWorkspaceTab('home')" id="nav-home" class="nav-btn flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-[#F1F5F9] transition whitespace-nowrap cursor-pointer">
        <i class="fa-solid fa-house w-4 text-center text-slate-500"></i>
        <span>Inicio</span>
      </button>

      <button onclick="switchWorkspaceTab('create')" id="nav-create" class="nav-btn flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-[#E0F2FE] text-[#0284C7] border border-[#BAE6FD] transition whitespace-nowrap cursor-pointer">
        <i class="fa-solid fa-wand-magic-sparkles w-4 text-center text-[#0284C7]"></i>
        <span>Crear Música</span>
      </button>

      <button onclick="switchWorkspaceTab('multitrack')" id="nav-multitrack" class="nav-btn flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-[#F1F5F9] transition whitespace-nowrap cursor-pointer">
        <i class="fa-solid fa-sliders w-4 text-center text-slate-500"></i>
        <span>Estudio Multipista</span>
      </button>

      <button onclick="switchWorkspaceTab('library')" id="nav-library" class="nav-btn flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-[#F1F5F9] transition whitespace-nowrap cursor-pointer">
        <i class="fa-solid fa-compact-disc w-4 text-center text-slate-500"></i>
        <span>Biblioteca BASA</span>
        <span id="nav-lib-count" class="ml-auto px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-[#F1F5F9] text-slate-800 border border-[#CBD5E1]">3</span>
      </button>

      <button onclick="switchWorkspaceTab('tools')" id="nav-tools" class="nav-btn flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-[#F1F5F9] transition whitespace-nowrap cursor-pointer">
        <i class="fa-solid fa-toolbox w-4 text-center text-slate-500"></i>
        <span>Herramientas Audio</span>
      </button>

      <!-- Tarjeta informativa en escritorio -->
      <div class="hidden lg:block mt-auto pt-4 border-t border-[#E2E8F0]">
        <div class="bg-[#F8FAFC] border border-[#CBD5E1] rounded-xl p-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-bold text-black">Síntesis Local</span>
            <span class="text-[11px] font-mono font-bold text-[#0284C7]">44.1 kHz</span>
          </div>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Generación rítmica en tiempo real con motores de percusión caribeña y armonía MIDI-DSP.
          </p>
        </div>
      </div>
    </nav>

    <!-- ÁREA CENTRAL DINÁMICA (Vistas de Navegación + Panel de Creación) -->
    <main class="flex-1 flex flex-col xl:flex-row gap-4 min-w-0">
      
      <!-- 3. PANEL DE CREACIÓN Y VISTAS SECUNDARIAS (IZQUIERDA/CENTRO) -->
      <section id="primary-workspace" class="flex-1 bg-white border border-[#CBD5E1] rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col min-w-0">
        
        <!-- VISTA A: CREAR MÚSICA (MODOS AGENT, CUSTOM, REMIX) -->
        <div id="view-create" class="workspace-view flex flex-col gap-4 h-full">
          
          <!-- Selector de Modos (Agent / Custom / Remix) -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-[#E2E8F0]">
            <div class="inline-flex p-1 bg-[#F1F5F9] border border-[#CBD5E1] rounded-xl w-full sm:w-auto">
              <button onclick="setCreationMode('agent')" id="mode-btn-agent" class="mode-tab flex-1 sm:flex-initial px-4 py-2 rounded-lg text-xs sm:text-sm font-bold bg-white text-[#0284C7] shadow-xs border border-[#BAE6FD] transition cursor-pointer flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-robot"></i>
                <span>Agent</span>
              </button>
              <button onclick="setCreationMode('custom')" id="mode-btn-custom" class="mode-tab flex-1 sm:flex-initial px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-black transition cursor-pointer flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-sliders"></i>
                <span>Custom</span>
              </button>
              <button onclick="setCreationMode('remix')" id="mode-btn-remix" class="mode-tab flex-1 sm:flex-initial px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-black transition cursor-pointer flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-shuffle"></i>
                <span>Remix</span>
              </button>
            </div>

            <div class="flex items-center gap-2 text-xs text-slate-600">
              <span class="font-semibold text-black">Modelo activo:</span>
              <span id="active-model-label" class="px-2.5 py-1 rounded-lg bg-[#E0F2FE] text-[#0284C7] font-mono font-bold border border-[#BAE6FD]">BASA-Audio-V10 Pro</span>
            </div>
          </div>

          <!-- SUB-PANEL 1: MODO AGENT (Asistente Creativo) -->
          <div id="panel-agent" class="creation-panel flex flex-col gap-4">
            <div class="bg-[#F8FAFC] border border-[#CBD5E1] rounded-2xl p-4">
              <div class="flex items-center justify-between mb-2">
                <label for="agent-idea-input" class="text-sm font-bold text-black flex items-center gap-2">
                  <i class="fa-solid fa-sparkles text-[#0284C7]"></i>
                  Describe tu idea musical, historia o ambiente
                </label>
                <span class="text-xs font-medium text-slate-500">Autocomposición IA</span>
              </div>
              <textarea id="agent-idea-input" rows="3" placeholder="Ej: Un merengue típico alegre con acordeón virtuoso y güira metálica sobre una fiesta en el Cibao al atardecer..." class="w-full rounded-xl border border-[#CBD5E1] bg-white p-3 text-sm text-black placeholder-slate-400 focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#E0F2FE] transition"></textarea>
              
              <!-- Chips de inspiración rápida -->
              <div class="mt-3">
                <span class="text-xs font-semibold text-slate-600 block mb-1.5">Ideas rápidas dominicanas y latinas:</span>
                <div class="flex flex-wrap gap-1.5">
                  <button type="button" onclick="fillAgentPrompt('Merengue típico cibaeño con acordeón rápido, tambora repicando y sabor a fiesta patronal')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-xs font-medium text-black transition cursor-pointer">
                    🪗 Merengue Típico Cibaeño
                  </button>
                  <button type="button" onclick="fillAgentPrompt('Bachata romántica de amargue con requinto cristalino, bongó suave y nostalgia bajo la lluvia en Santo Domingo')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-xs font-medium text-black transition cursor-pointer">
                    🎸 Bachata Rosa &amp; Requinto
                  </button>
                  <button type="button" onclick="fillAgentPrompt('Salsa dura de barrio con trombones potentes, piano montuno, timbal y coro callejero')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-xs font-medium text-black transition cursor-pointer">
                    🎺 Salsa Dura &amp; Montuno
                  </button>
                  <button type="button" onclick="fillAgentPrompt('Dembow dominicano energético con bajo 808 pesado, percusión sincopada y coro viral')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-xs font-medium text-black transition cursor-pointer">
                    🔊 Dembow Urbano RD
                  </button>
                  <button type="button" onclick="fillAgentPrompt('Bolero clásico bohemio con guitarras acústicas, contrabajo y poesía nocturna')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-xs font-medium text-black transition cursor-pointer">
                    🌙 Bolero Bohemio
                  </button>
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <label for="agent-genre-hint" class="text-xs font-bold text-slate-700">Género base:</label>
                  <select id="agent-genre-hint" class="rounded-xl border border-[#CBD5E1] bg-white px-3 py-1.5 text-xs font-bold text-black focus:outline-none focus:border-[#0284C7]">
                    <option value="auto">Detectar automáticamente</option>
                    <option value="Merengue Típico">Merengue Típico</option>
                    <option value="Bachata">Bachata</option>
                    <option value="Bolero">Bolero</option>
                    <option value="Salsa Dura">Salsa Dura</option>
                    <option value="Merengue de Calle">Merengue de Calle</option>
                    <option value="Dembow">Dembow</option>
                    <option value="Ranchera">Ranchera</option>
                  </select>
                </div>

                <button type="button" onclick="runAgentComposer()" class="px-4 py-2.5 rounded-xl bg-[#0284C7] hover:bg-[#0369A1] text-white text-xs sm:text-sm font-bold shadow-xs transition flex items-center gap-2 cursor-pointer">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                  <span>Generar Estructura &amp; Letra en Editor</span>
                </button>
              </div>
            </div>

            <!-- Vista previa rápida de lo que el Agent enviará al estudio -->
            <div class="bg-white border border-[#CBD5E1] rounded-2xl p-4 flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Flujo Inteligente BASA Agent</h3>
                <span class="text-xs font-semibold text-[#0284C7]">Sincronizado con Modo Custom</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-700">
                El asistente redacta la letra con etiquetas estructurales (<code class="px-1.5 py-0.5 bg-[#F1F5F9] rounded text-black font-mono text-xs">[Intro]</code>, <code class="px-1.5 py-0.5 bg-[#F1F5F9] rounded text-black font-mono text-xs">[Verso]</code>, <code class="px-1.5 py-0.5 bg-[#F1F5F9] rounded text-black font-mono text-xs">[Coro]</code>, <code class="px-1.5 py-0.5 bg-[#F1F5F9] rounded text-black font-mono text-xs">[Mambo]</code>, <code class="px-1.5 py-0.5 bg-[#F1F5F9] rounded text-black font-mono text-xs">[Outro]</code>), ajusta el BPM óptimo y selecciona los instrumentos tradicionales correspondientes.
              </p>
            </div>
          </div>

          <!-- SUB-PANEL 2: MODO CUSTOM (Editor Completo) -->
          <div id="panel-custom" class="creation-panel hidden flex-col gap-4">
            
            <!-- Título y Género -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <div>
                <label for="track-title" class="block text-xs font-bold text-black mb-1">Título de la Obra</label>
                <input type="text" id="track-title" value="Brisa del Cibao en Abril" placeholder="Escribe el título de tu canción..." class="w-full rounded-xl border border-[#CBD5E1] bg-white px-3.5 py-2 text-sm font-semibold text-black focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#E0F2FE]">
              </div>
              <div>
                <label for="track-genre" class="block text-xs font-bold text-black mb-1">Género / Ritmo Principal</label>
                <select id="track-genre" onchange="applyGenreDefaults()" class="w-full rounded-xl border border-[#CBD5E1] bg-white px-3.5 py-2 text-sm font-bold text-black focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#E0F2FE]">
                  <option value="Merengue Típico">Merengue Típico (Perico Ripiao)</option>
                  <option value="Bachata">Bachata (Tradicional / Moderna)</option>
                  <option value="Bolero">Bolero (Clásico / Filin)</option>
                  <option value="Salsa Dura">Salsa Dura (Brava / Montuno)</option>
                  <option value="Merengue de Calle">Merengue de Calle (Urbano)</option>
                  <option value="Dembow">Dembow (Dominicano 808)</option>
                  <option value="Ranchera">Ranchera (Mariachi / Norteña)</option>
                </select>
              </div>
            </div>

            <!-- Editor de Letra con Etiquetas Estructurales -->
            <div class="bg-[#F8FAFC] border border-[#CBD5E1] rounded-2xl p-3">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <label for="track-lyrics" class="text-xs font-bold text-black flex items-center gap-1.5">
                  <i class="fa-solid fa-align-left text-[#0284C7]"></i>
                  Letra y Estructura Musical
                </label>
                <div class="flex flex-wrap items-center gap-1">
                  <button type="button" onclick="insertTag('[Intro]')" class="px-2 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-mono font-bold text-black cursor-pointer">+ [Intro]</button>
                  <button type="button" onclick="insertTag('[Verso]')" class="px-2 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-mono font-bold text-black cursor-pointer">+ [Verso]</button>
                  <button type="button" onclick="insertTag('[Coro]')" class="px-2 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-mono font-bold text-black cursor-pointer">+ [Coro]</button>
                  <button type="button" onclick="insertTag('[Mambo]')" class="px-2 py-1 rounded-lg bg-[#E0F2FE] hover:bg-[#BAE6FD] border border-[#38BDF8] text-[11px] font-mono font-bold text-[#0284C7] cursor-pointer">+ [Mambo]</button>
                  <button type="button" onclick="insertTag('[Requinto Solo]')" class="px-2 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-mono font-bold text-black cursor-pointer">+ [Requinto]</button>
                  <button type="button" onclick="insertTag('[Outro]')" class="px-2 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-mono font-bold text-black cursor-pointer">+ [Outro]</button>
                </div>
              </div>
              <textarea id="track-lyrics" rows="7" class="w-full rounded-xl border border-[#CBD5E1] bg-white p-3 text-xs sm:text-sm font-mono text-black leading-relaxed focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-[#E0F2FE]">[Intro]
(Repique de tambora y rasgueo brillante de güira metálica)

[Verso]
Cuando cae la tarde sobre la loma verde
Suena el acordeón llamando al corazón
No hay pena que dure cuando el ritmo enciende
La fiesta del pueblo con pura tradición

[Coro]
¡Baila mi gente, que llegó el sabor!
Con tambora y güira se alegra el alma mía
BASA en el estudio marcando el compás
De mi tierra linda, pura melodía

[Mambo]
(Solo virtuoso de acordeón con corte rítmico de saxofón y tambora)

[Outro]
(Cierre en seco con redoble de tambora y acorde mayor)</textarea>
            </div>

            <!-- Instrumentación Clave (Multi-selección) -->
            <div>
              <span class="block text-xs font-bold text-black mb-1.5">Instrumentación Clave del Arreglo</span>
              <div id="instruments-container" class="flex flex-wrap gap-2">
                <!-- Se renderizan dinámicamente con JS -->
              </div>
            </div>

            <!-- Tipo de Voz, Tonalidad, BPM y Duración -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 bg-[#F8FAFC] border border-[#CBD5E1] rounded-2xl p-3">
              <div>
