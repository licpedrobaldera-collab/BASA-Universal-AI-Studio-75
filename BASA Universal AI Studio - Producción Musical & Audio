    function closeLyricsModal() {
      const modal = document.getElementById('lyrics-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function loadModalTrackIntoEditor() {
      if (!modalInspectedTrack) return;
      document.getElementById('track-title').value = modalInspectedTrack.title;
      document.getElementById('track-genre').value = modalInspectedTrack.genre;
      document.getElementById('track-bpm').value = modalInspectedTrack.bpm;
      document.getElementById('track-duration').value = modalInspectedTrack.duration;
      document.getElementById('track-key').value = modalInspectedTrack.key;
      document.getElementById('track-lyrics').value = modalInspectedTrack.lyrics;
      selectedInstruments = new Set(modalInspectedTrack.instruments);

      renderInstrumentChips();
      updateRangeLabels();
      closeLyricsModal();
