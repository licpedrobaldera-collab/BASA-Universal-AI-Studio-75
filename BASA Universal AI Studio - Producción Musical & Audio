     * PERSISTENCIA EN LOCALSTORAGE
     * ============================================================================
     */
    function loadLibraryFromStorage() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            libraryTracks = parsed;
            return;
          }
        }
      } catch (err) {
        console.warn('Error leyendo localStorage:', err);
      }
      libraryTracks = JSON.parse(JSON.stringify(DEFAULT_LIBRARY));
      saveLibraryToStorage();
    }

    function saveLibraryToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(libraryTracks));
      } catch (err) {
        console.warn('Error guardando en localStorage:', err);
      }
      updateLibraryCounters();
      populateRemixSelectors();
    }

    function resetDemoLibrary() {
      libraryTracks = JSON.parse(JSON.stringify(DEFAULT_LIBRARY));
      saveLibraryToStorage();
      renderLibrary();
      selectTrackForPlayer(libraryTracks[0].id, false);
      showToast('Biblioteca restaurada con las 3 pistas maestras de BASA.', 'info');
    }

