    }

    /**
     * ============================================================================
     * MOTOR DE AUDIO SINTETIZADO WEB AUDIO API (TIEMPO REAL + VISUALIZADOR)
     * ============================================================================
     */
    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();

        masterGainNode = audioCtx.createGain();
        masterGainNode.gain.value = masterVolume;

        analyserNode = audioCtx.createAnalyser();
        analyserNode.fftSize = 64;
        analyserNode.smoothingTimeConstant = 0.8;

        masterGainNode.connect(analyserNode);
        analyserNode.connect(audioCtx.destination);
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function selectTrackForPlayer(trackId, autoPlay = false) {
      const track = libraryTracks.find(t => t.id === trackId);
      if (!track) return;

      const wasPlaying = isPlaying;
      stopPlayback();

      currentTrackId = track.id;
      playbackElapsed = 0;

      // Actualizar interfaz del reproductor inferior
      document.getElementById('player-cover-mini').innerHTML = generateDynamicCoverSVG(track);
      document.getElementById('player-track-title').textContent = track.title;
      document.getElementById('player-genre-badge').textContent = track.genre;
      document.getElementById('player-track-meta').textContent = `${track.bpm} BPM • Tonalidad ${track.key} • ${track.instruments.slice(0, 3).join(', ')}`;
      document.getElementById('player-time-current').textContent = '00:00';
      document.getElementById('player-time-total').textContent = formatSeconds(track.duration);
      document.getElementById('player-progress-bar').style.width = '0%';

      renderLibrary();

      if (autoPlay || wasPlaying) {
        startPlayback();
      }
    }

    function toggleSpecificTrack(trackId) {
      if (currentTrackId === trackId) {
        togglePlayCurrent();
      } else {
        selectTrackForPlayer(trackId, true);
      }
    }

    function togglePlayCurrent() {
      if (!currentTrackId && libraryTracks.length > 0) {
        selectTrackForPlayer(libraryTracks[0].id, true);
        return;
      }
      if (isPlaying) {
        pausePlayback();
      } else {
        startPlayback();
      }
    }

    function startPlayback() {
      const track = libraryTracks.find(t => t.id === currentTrackId);
      if (!track) return;

      ensureAudioContext();
      isPlaying = true;
      updatePlayButtonUI();
      renderLibrary();

      // Intervalo de pasos semicorcheas (16 pasos por compás)
      const stepDurationMs = (60 / track.bpm / 4) * 1000;

      // Disparar primer paso inmediatamente
      triggerSynthesizedStep(track, currentStep);
      currentStep = (currentStep + 1) % 16;

      schedulerTimer = setInterval(() => {
        if (!isPlaying) return;
        triggerSynthesizedStep(track, currentStep);
        currentStep = (currentStep + 1) % 16;
      }, stepDurationMs);

      progressTimer = setInterval(() => {
        if (!isPlaying) return;
        playbackElapsed += 0.25;
        if (playbackElapsed >= track.duration) {
          playbackElapsed = 0;
        }
        const pct = Math.min(100, (playbackElapsed / track.duration) * 100);
        document.getElementById('player-progress-bar').style.width = `${pct}%`;
        document.getElementById('player-time-current').textContent = formatSeconds(Math.floor(playbackElapsed));
      }, 250);
    }

    function pausePlayback() {
      isPlaying = false;
      clearInterval(schedulerTimer);
      clearInterval(progressTimer);
      updatePlayButtonUI();
      renderLibrary();
    }

    function stopPlayback() {
      isPlaying = false;
      clearInterval(schedulerTimer);
      clearInterval(progressTimer);
      currentStep = 0;
      playbackElapsed = 0;
      document.getElementById('player-progress-bar').style.width = '0%';
      document.getElementById('player-time-current').textContent = '00:00';
      updatePlayButtonUI();
      renderLibrary();
    }

    function playNextTrack() {
      if (libraryTracks.length === 0) return;
      const idx = libraryTracks.findIndex(t => t.id === currentTrackId);
      const nextIdx = (idx + 1) % libraryTracks.length;
      selectTrackForPlayer(libraryTracks[nextIdx].id, isPlaying);
    }

    function playPreviousTrack() {
      if (libraryTracks.length === 0) return;
      const idx = libraryTracks.findIndex(t => t.id === currentTrackId);
      const prevIdx = (idx - 1 + libraryTracks.length) % libraryTracks.length;
      selectTrackForPlayer(libraryTracks[prevIdx].id, isPlaying);
    }

    function seekPlayback(event) {
      const track = libraryTracks.find(t => t.id === currentTrackId);
      if (!track) return;
      const rect = event.currentTarget.getBoundingClientRect();
      const clickX = event.clientX - rect.left;
      const ratio = Math.max(0, Math.min(1, clickX / rect.width));
      playbackElapsed = ratio * track.duration;
      document.getElementById('player-progress-bar').style.width = `${ratio * 100}%`;
      document.getElementById('player-time-current').textContent = formatSeconds(Math.floor(playbackElapsed));
    }

    function updatePlayButtonUI() {
      const icon = document.getElementById('main-play-icon');
      if (isPlaying) {
        icon.classList.remove('fa-play', 'ml-0.5');
        icon.classList.add('fa-pause');
      } else {
        icon.classList.remove('fa-pause');
        icon.classList.add('fa-play', 'ml-0.5');
      }
    }

    function setMasterVolume(val) {
      masterVolume = val / 100;
      if (masterGainNode) {
        masterGainNode.gain.setValueAtTime(masterVolume, audioCtx.currentTime);
      }
    }

    /**
     * Síntesis Rítmica y Armónica por Paso según Género
     */
    function triggerSynthesizedStep(track, step) {
      if (!audioCtx || !masterGainNode) return;
      const now = audioCtx.currentTime;
      const preset = GENRE_PRESETS[track.genre] || GENRE_PRESETS['Merengue Típico'];
      const scale = preset.scaleFreqs;

      // 1. CANAL PERCUSIÓN (Tambora / Bombo / Güira / Bongó)
      if (!stemState.perc.muted && stemState.perc.vol > 0) {
        const pVol = stemState.perc.vol * 0.45;

        // Golpe grave (Tambora / Bombo)
        const isKickStep =
          (track.genre.includes('Merengue') && (step % 4 === 0 || step === 14)) ||
          (track.genre === 'Bachata' && (step === 0 || step === 4 || step === 8 || step === 12 || step === 14)) ||
          (track.genre === 'Dembow' && (step % 4 === 0)) ||
          (track.genre === 'Salsa Dura' && (step === 0 || step === 6 || step === 8 || step === 14)) ||
          ((track.genre === 'Bolero' || track.genre === 'Ranchera') && (step === 0 || step === 8));

        if (isKickStep) {
          playDrumKick(now, pVol, track.genre === 'Dembow' ? 48 : 72);
        }

        // Golpe agudo / Slap / Caja / Dembow snare
        const isSnareStep =
          (track.genre === 'Dembow' && (step === 3 || step === 6 || step === 11 || step === 14)) ||
          (track.genre.includes('Merengue') && (step === 2 || step === 6 || step === 10 || step === 14)) ||
          (track.genre === 'Bachata' && (step === 6 || step === 14)) ||
          (track.genre === 'Salsa Dura' && (step === 4 || step === 10 || step === 12));

        if (isSnareStep) {
          playPercussionSlap(now, pVol * 0.75);
        }

        // Raspado continuo de Güira Metálica / Hi-Hat
        if (step % 2 === 0 || track.genre.includes('Merengue')) {
          const accent = step % 4 === 0 ? 1.0 : 0.45;
          playGuiraScrape(now, pVol * 0.25 * accent);
        }
      }

      // 2. CANAL BAJO / TUMBAO
      if (!stemState.bass.muted && stemState.bass.vol > 0) {
        const bVol = stemState.bass.vol * 0.35;
        if (step === 0 || step === 6 || step === 8 || step === 14) {
          const bassNote = (step === 8 || step === 14) ? scale[4] / 2 : scale[0] / 2;
          playTone(now, bassNote, 'triangle', 0.22, bVol);
        }
      }

      // 3. CANAL ARMONÍA / REQUINTO / PIANO MONTUNO
      if (!stemState.chord.muted && stemState.chord.vol > 0) {
        const cVol = stemState.chord.vol * 0.22;
        if (step % 4 === 2 || step === 0) {
          const chordRoot = scale[(step / 4) % 4];
          playTone(now, chordRoot, 'sine', 0.18, cVol);
          playTone(now, chordRoot * 1.25, 'sine', 0.18, cVol * 0.8);
        }
      }

      // 4. CANAL MELODÍA LÍDER (Acordeón / Requinto / Metales)
      if (!stemState.lead.muted && stemState.lead.vol > 0) {
        const lVol = stemState.lead.vol * 0.24;
        // Patrón melódico sincopado
        const melodyPattern = [0, -1, 2, -1, 4, 3, 2, -1, 5, -1, 4, 2, 1, -1, 0, -1];
        const noteIndex = melodyPattern[step];
        if (noteIndex >= 0) {
          const freq = scale[noteIndex % scale.length] * (track.genre === 'Bachata' ? 2 : 1);
          const waveType = track.genre.includes('Merengue') || track.genre === 'Salsa Dura' ? 'sawtooth' : 'triangle';
          playTone(now, freq, waveType, 0.16, lVol);
        }
      }
    }

    function playDrumKick(time, gainVal, startFreq = 70) {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(startFreq * 1.8, time);
      osc.frequency.exponentialRampToValueAtTime(38, time + 0.12);

      gain.gain.setValueAtTime(gainVal, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.16);

      osc.connect(gain);
      gain.connect(masterGainNode);
      osc.start(time);
      osc.stop(time + 0.17);
    }

    function playPercussionSlap(time, gainVal) {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(320, time);
      osc.frequency.exponentialRampToValueAtTime(110, time + 0.08);

      gain.gain.setValueAtTime(gainVal, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.09);

      osc.connect(gain);
      gain.connect(masterGainNode);
      osc.start(time);
      osc.stop(time + 0.1);
    }

    function playGuiraScrape(time, gainVal) {
      const bufferSize = audioCtx.sampleRate * 0.045;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }

      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.value = 5500;

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(gainVal, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.045);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(masterGainNode);
      noise.start(time);
    }

    function playTone(time, freq, type, dur, gainVal) {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const filter = audioCtx.createBiquadFilter();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, time);

      filter.type = 'lowpass';
      filter.frequency.value = type === 'sawtooth' ? 1800 : 3200;

      gain.gain.setValueAtTime(0.001, time);
      gain.gain.linearRampToValueAtTime(gainVal, time + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.001, time + dur);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(masterGainNode);

      osc.start(time);
      osc.stop(time + dur + 0.02);
    }

    /**
     * ============================================================================
     * CONTROLES DEL ESTUDIO MULTIPISTA
     * ============================================================================
     */
    function updateStemVolume(stem, val) {
      stemState[stem].vol = val / 100;
      document.getElementById(`val-${stem}`).textContent = `${val}%`;
    }

    function toggleMuteStem(stem) {
      stemState[stem].muted = !stemState[stem].muted;
      const btn = document.getElementById(`mute-${stem}`);
      if (stemState[stem].muted) {
        btn.textContent = 'MUTE';
        btn.classList.add('bg-red-100', 'text-red-700', 'border-red-300');
      } else {
        btn.textContent = 'ON';
        btn.classList.remove('bg-red-100', 'text-red-700', 'border-red-300');
      }
    }

    function resetMixerStems() {
      const defaults = { perc: 85, bass: 90, chord: 75, lead: 80 };
      Object.keys(defaults).forEach(k => {
        stemState[k].vol = defaults[k] / 100;
        stemState[k].muted = false;
        document.getElementById(`vol-${k}`).value = defaults[k];
        document.getElementById(`val-${k}`).textContent = `${defaults[k]}%`;
        const btn = document.getElementById(`mute-${k}`);
        btn.textContent = 'ON';
        btn.classList.remove('bg-red-100', 'text-red-700', 'border-red-300');
      });
      showToast('Niveles de consola multipista restablecidos.', 'info');
    }

    /**
     * ============================================================================
     * VISUALIZADOR DE FRECUENCIAS EN CANVAS RESPONSIVO
     * ============================================================================
     */
    function initVisualizerCanvas() {
      const canvas = document.getElementById('visualizer-canvas');
      const ctx = canvas.getContext('2d');

      function resizeCanvas() {
        const rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = rect.width * window.devicePixelRatio;
        canvas.height = rect.height * window.devicePixelRatio;
      }

      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);

      function draw() {
        requestAnimationFrame(draw);
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        const bars = 24;
        const gap = 3 * window.devicePixelRatio;
        const barWidth = (w - gap * (bars - 1)) / bars;

        let freqData = null;
        if (analyserNode && isPlaying) {
          freqData = new Uint8Array(analyserNode.frequencyBinCount);
          analyserNode.getByteFrequencyData(freqData);
        }

        for (let i = 0; i < bars; i++) {
          let magnitude = 0.12;
          if (freqData && isPlaying) {
            const val = freqData[i % freqData.length] / 255;
            magnitude = Math.max(0.12, val);
          }

          const barHeight = magnitude * (h * 0.85);
          const x = i * (barWidth + gap);
          const y = (h - barHeight) / 2;

          ctx.fillStyle = isPlaying ? '#0284C7' : '#CBD5E1';
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, barHeight, 3);
          ctx.fill();
        }
      }
      draw();
    }

    /**
     * ============================================================================
     * RENDERIZADO OFFLINE Y DESCARGA DE ARCHIVO WAV REAL
     * ============================================================================
     */
    function downloadCurrentTrackWAV() {
      if (!currentTrackId) return;
      downloadTrackWAVById(currentTrackId);
    }

    async function downloadTrackWAVById(trackId) {
      const track = libraryTracks.find(t => t.id === trackId);
      if (!track) return;

      showToast(`Renderizando master WAV de "${track.title}"...`, 'info');

      try {
        // Renderizar 8 segundos de muestra rítmica en OfflineAudioContext a 44.1kHz
        const sampleRate = 44100;
        const renderSeconds = 8;
        const offlineCtx = new OfflineAudioContext(1, sampleRate * renderSeconds, sampleRate);
        const preset = GENRE_PRESETS[track.genre] || GENRE_PRESETS['Merengue Típico'];
        const scale = preset.scaleFreqs;
        const stepSec = 60 / track.bpm / 4;
        const totalSteps = Math.floor(renderSeconds / stepSec);

        for (let s = 0; s < totalSteps; s++) {
          const t = s * stepSec;
          const stepMod = s % 16;

          // Percusión
          if (stepMod % 4 === 0) {
            const osc = offlineCtx.createOscillator();
            const g = offlineCtx.createGain();
            osc.frequency.setValueAtTime(110, t);
            osc.frequency.exponentialRampToValueAtTime(40, t + 0.12);
            g.gain.setValueAtTime(0.4, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
            osc.connect(g);
            g.connect(offlineCtx.destination);
            osc.start(t);
            osc.stop(t + 0.16);
          }

          // Melodía y Bajo
          if (stepMod % 2 === 0) {
            const osc = offlineCtx.createOscillator();
            const g = offlineCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(scale[(s / 2) % scale.length], t);
            g.gain.setValueAtTime(0.18, t);
            g.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
            osc.connect(g);
            g.connect(offlineCtx.destination);
            osc.start(t);
            osc.stop(t + 0.2);
          }
        }

        const renderedBuffer = await offlineCtx.startRendering();
        const wavBlob = audioBufferToWavBlob(renderedBuffer);
        const url = URL.createObjectURL(wavBlob);

        const a = document.createElement('a');
        a.href = url;
        a.download = `${track.title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}_BASA.wav`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        showToast(`Archivo WAV descargado: ${track.title}`, 'success');
      } catch (error) {
        console.error(error);
        showToast('No se pudo generar el archivo WAV en este navegador.', 'warn');
      }
    }

    function audioBufferToWavBlob(buffer) {
      const numOfChan = buffer.numberOfChannels;
      const length = buffer.length * numOfChan * 2 + 44;
      const out = new ArrayBuffer(length);
      const view = new DataView(out);
      const channels = [];
      let sample = 0;
      let offset = 0;
      let pos = 0;

      const setUint16 = (data) => { view.setUint16(pos, data, true); pos += 2; };
      const setUint32 = (data) => { view.setUint32(pos, data, true); pos += 4; };

      // Cabecera RIFF WAVE
      setUint32(0x46464952); // "RIFF"
      setUint32(length - 8);
      setUint32(0x45564157); // "WAVE"
      setUint32(0x20746d66); // "fmt "
      setUint32(16);
      setUint16(1); // PCM
      setUint16(numOfChan);
      setUint32(buffer.sampleRate);
      setUint32(buffer.sampleRate * 2 * numOfChan);
      setUint16(numOfChan * 2);
      setUint16(16);
      setUint32(0x61746164); // "data"
      setUint32(length - pos - 4);

      for (let i = 0; i < buffer.numberOfChannels; i++) {
        channels.push(buffer.getChannelData(i));
      }

      while (pos < length) {
        for (let i = 0; i < numOfChan; i++) {
          sample = Math.max(-1, Math.min(1, channels[i][offset]));
          sample = (0.5 + sample < 0 ? sample * 32768 : sample * 32767) | 0;
          view.setInt16(pos, sample, true);
          pos += 2;
        }
        offset++;
      }

      return new Blob([out], { type: 'audio/wav' });
    }

    /**
     * ============================================================================
     * EXPORTACIONES (PROYECTO JSON, LETRA TXT Y GUION/PROMPT)
     * ============================================================================
     */
    function exportProjectJSON() {
      const projectData = {
        studio: 'BASA Universal AI Studio',
        version: '10.4',
        exportedAt: new Date().toISOString(),
        activeModel: document.getElementById('ai-model-select').value,
        currentDraft: {
          title: document.getElementById('track-title').value,
          genre: document.getElementById('track-genre').value,
          bpm: document.getElementById('track-bpm').value,
          key: document.getElementById('track-key').value,
          instruments: Array.from(selectedInstruments),
          lyrics: document.getElementById('track-lyrics').value
        },
        library: libraryTracks
      };

      const blob = new Blob([JSON.stringify(projectData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `BASA_Studio_Proyecto_${Date.now()}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Proyecto completo exportado en JSON.', 'success');
    }

    function downloadLyricsTXT() {
      const title = document.getElementById('track-title').value || 'Letra_BASA';
      const genre = document.getElementById('track-genre').value;
      const bpm = document.getElementById('track-bpm').value;
      const lyrics = document.getElementById('track-lyrics').value;

      const content = `BASA UNIVERSAL AI STUDIO — HOJA DE LETRA Y ARREGLO\nTítulo: ${title}\nGénero: ${genre} | Tempo: ${bpm} BPM\nInstrumentos: ${Array.from(selectedInstruments).join(', ')}\n==================================================\n\n${lyrics}`;

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${title.replace(/[^a-z0-9]/gi, '_')}_Letra.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Archivo de letra TXT descargado.', 'success');
    }

    function exportPromptScript() {
      const title = document.getElementById('track-title').value;
      const genre = document.getElementById('track-genre').value;
      const bpm = document.getElementById('track-bpm').value;
      const key = document.getElementById('track-key').value;
      const voice = document.getElementById('track-voice').value;
      const model = document.getElementById('ai-model-select').value;

      const script = `[BASA STUDIO PROMPT] Modelo: ${model} | Título: "${title}" | Género: ${genre} | ${bpm} BPM | Escala: ${key} | Voz: ${voice} | Instrumentación: ${Array.from(selectedInstruments).join(', ')}`;

      // Uso de textarea temporal + execCommand('copy') para máxima compatibilidad en iframes
      const tempInput = document.createElement('textarea');
      tempInput.value = script;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);

      showToast('Guion/Prompt copiado al portapapeles.', 'success');
    }

    /**
     * ============================================================================
     * UTILIDADES: TAP TEMPO, FORMATO Y NOTIFICACIONES TOAST
     * ============================================================================
     */
    function handleTapTempo() {
      const now = Date.now();
      if (tapTimes.length > 0 && now - tapTimes[tapTimes.length - 1] > 2500) {
        tapTimes = [];
      }
      tapTimes.push(now);
      if (tapTimes.length > 6) tapTimes.shift();

      if (tapTimes.length >= 2) {
        let intervals = 0;
        for (let i = 1; i < tapTimes.length; i++) {
          intervals += tapTimes[i] - tapTimes[i - 1];
        }
        const avgMs = intervals / (tapTimes.length - 1);
        lastTappedBpm = Math.max(65, Math.min(175, Math.round(60000 / avgMs)));
        document.getElementById('tap-bpm-result').textContent = lastTappedBpm;
      }
    }

    function applyTappedBpm() {
      document.getElementById('track-bpm').value = lastTappedBpm;
      updateRangeLabels();
      switchWorkspaceTab('create');
      setCreationMode('custom');
      showToast(`Tempo de ${lastTappedBpm} BPM aplicado al compositor.`, 'success');
    }

    function formatSeconds(totalSec) {
      const mins = Math.floor(totalSec / 60);
      const secs = totalSec % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const styles = {
        success: 'bg-white border-l-4 border-[#0284C7] text-black',
        info: 'bg-white border-l-4 border-[#38BDF8] text-black',
        warn: 'bg-white border-l-4 border-amber-500 text-black'
      };

      const icons = {
        success: 'fa-circle-check text-[#0284C7]',
        info: 'fa-circle-info text-[#0284C7]',
        warn: 'fa-triangle-exclamation text-amber-600'
      };

      toast.className = `${styles[type] || styles.info} border border-[#CBD5E1] rounded-xl p-3 shadow-md flex items-center gap-2.5 text-xs font-semibold pointer-events-auto transition-all duration-300`;
      toast.innerHTML = `
        <i class="fa-solid ${icons[type] || icons.info} text-sm shrink-0"></i>
        <span class="flex-1">${message}</span>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-6px)';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }
  </script>
