    /**
     * ============================================================================
     * MODO AGENT: COMPOSITOR INTELIGENTE DE LETRAS Y ESTRUCTURA
     * ============================================================================
     */
    function fillAgentPrompt(text) {
      document.getElementById('agent-idea-input').value = text;
    }

    function runAgentComposer() {
      const idea = document.getElementById('agent-idea-input').value.trim();
      const hintGenre = document.getElementById('agent-genre-hint').value;

      if (!idea) {
        showToast('Escribe primero una idea o selecciona una sugerencia rápida.', 'warn');
        return;
      }

      // Detectar género por palabras clave si está en automático
      let detectedGenre = hintGenre;
      if (detectedGenre === 'auto') {
        const lower = idea.toLowerCase();
        if (lower.includes('bachata') || lower.includes('requinto') || lower.includes('amargue')) detectedGenre = 'Bachata';
        else if (lower.includes('salsa') || lower.includes('trombón') || lower.includes('montuno')) detectedGenre = 'Salsa Dura';
        else if (lower.includes('dembow') || lower.includes('808') || lower.includes('urbano')) detectedGenre = 'Dembow';
        else if (lower.includes('calle') || lower.includes('mambo urbano')) detectedGenre = 'Merengue de Calle';
        else if (lower.includes('bolero') || lower.includes('bohemio')) detectedGenre = 'Bolero';
        else if (lower.includes('ranchera') || lower.includes('mariachi')) detectedGenre = 'Ranchera';
        else detectedGenre = 'Merengue Típico';
      }

      const preset = GENRE_PRESETS[detectedGenre] || GENRE_PRESETS['Merengue Típico'];

      // Generar título creativo basado en la idea
      const words = idea.replace(/[.,!?]/g, '').split(' ').filter(w => w.length > 3);
      const keyword = words.length > 0 ? words[Math.floor(Math.random() * Math.min(words.length, 4))] : 'Caribe';
      const capitalizedKeyword = keyword.charAt(0).toUpperCase() + keyword.slice(1);
      const generatedTitle = `${detectedGenre}: Eco de ${capitalizedKeyword}`;

      // Generar letra estructurada contextual
      const generatedLyrics = `[Intro]\n(Entrada instrumental de ${preset.instruments.slice(0, 2).join(' y ')} a ${preset.bpm} BPM)\n\n[Verso]\nInspirado en esta historia: ${idea.slice(0, 75)}\nEl ritmo va subiendo con fuerza y sentimiento\nCada compás dibuja nuestra propia identidad\nCon el sello inconfundible de BASA Universal\n\n[Coro]\n¡Suena el ${detectedGenre} con toda su pasión!\nQue retumbe la pista y vibre el corazón\nDe Santo Domingo para el mundo entero\nEste arreglo maestro llegó primero\n\n[Mambo]\n(Puente instrumental con ${preset.instruments.join(', ')})\n\n[Outro]\n(Cierre magistral en tonalidad ${preset.key})`;

      // Volcar datos al editor Custom
      document.getElementById('track-title').value = generatedTitle;
      document.getElementById('track-genre').value = detectedGenre;
      document.getElementById('track-bpm').value = preset.bpm;
      document.getElementById('track-key').value = preset.key;
      document.getElementById('track-lyrics').value = generatedLyrics;

      selectedInstruments = new Set(preset.instruments);
      renderInstrumentChips();
      updateRangeLabels();

      // Cambiar automáticamente a Custom para revisión y producción
      setCreationMode('custom');
      showToast(`Agent generó "${generatedTitle}" (${detectedGenre}). Revisa y pulsa Producir.`, 'success');
    }

    /**
     * ============================================================================
     * MODO CUSTOM: CONTROLES DE EDICIÓN E INSTRUMENTACIÓN
     * ============================================================================
     */
    function renderInstrumentChips() {
      const container = document.getElementById('instruments-container');
      container.innerHTML = '';

      AVAILABLE_INSTRUMENTS.forEach(inst => {
        const isSelected = selectedInstruments.has(inst);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = isSelected
          ? 'px-3 py-1.5 rounded-xl text-xs font-bold bg-[#E0F2FE] text-[#0284C7] border border-[#38BDF8] transition flex items-center gap-1.5 cursor-pointer'
          : 'px-3 py-1.5 rounded-xl text-xs font-semibold bg-white hover:bg-[#F8FAFC] text-slate-700 border border-[#CBD5E1] transition flex items-center gap-1.5 cursor-pointer';

        btn.innerHTML = `<i class="fa-solid ${isSelected ? 'fa-check-circle' : 'fa-plus'} text-[11px]"></i><span>${inst}</span>`;
        btn.onclick = () => {
          if (selectedInstruments.has(inst)) {
            if (selectedInstruments.size > 1) selectedInstruments.delete(inst);
          } else {
            selectedInstruments.add(inst);
          }
          renderInstrumentChips();
        };
        container.appendChild(btn);
      });
    }

    function applyGenreDefaults() {
      const genre = document.getElementById('track-genre').value;
      const preset = GENRE_PRESETS[genre];
      if (!preset) return;

      document.getElementById('track-bpm').value = preset.bpm;
      document.getElementById('track-key').value = preset.key;
      selectedInstruments = new Set(preset.instruments);
      renderInstrumentChips();
      updateRangeLabels();
    }

    function insertTag(tagText) {
      const textarea = document.getElementById('track-lyrics');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const currentVal = textarea.value;
      const insertion = `\n${tagText}\n`;
      textarea.value = currentVal.substring(0, start) + insertion + currentVal.substring(end);
      textarea.focus();
      textarea.selectionStart = textarea.selectionEnd = start + insertion.length;
    }

    function updateRangeLabels() {
      const bpm = document.getElementById('track-bpm').value;
      const dur = parseInt(document.getElementById('track-duration').value, 10);
      document.getElementById('bpm-display').textContent = `${bpm} BPM`;
      document.getElementById('duration-display').textContent = formatSeconds(dur);
    }

    /**
     * ============================================================================
     * PRODUCCIÓN DE PISTAS Y MODO REMIX
     * ============================================================================
     */
    function generateNewTrack() {
      // Si el usuario está en Agent y pulsa Producir directamente, ejecutar Agent primero si el título está vacío
      const titleInput = document.getElementById('track-title').value.trim();
      const title = titleInput || 'Producción BASA Sin Título';
      const genre = document.getElementById('track-genre').value;
      const bpm = parseInt(document.getElementById('track-bpm').value, 10);
      const duration = parseInt(document.getElementById('track-duration').value, 10);
      const key = document.getElementById('track-key').value;
      const voice = document.getElementById('track-voice').value;
      const lyrics = document.getElementById('track-lyrics').value.trim();
      const model = document.getElementById('ai-model-select').value;

      const newTrack = {
        id: 'basa-' + Date.now(),
        title,
        genre,
        bpm,
        duration,
        key,
        voice,
        model,
        instruments: Array.from(selectedInstruments),
        createdAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        lyrics: lyrics || '[Instrumental generado por BASA AI]'
      };

      libraryTracks.unshift(newTrack);
      saveLibraryToStorage();
      renderLibrary();
      selectTrackForPlayer(newTrack.id, true);
      showToast(`Pista "${title}" producida y reproduciendo en el motor BASA.`, 'success');
    }

    function populateRemixSelectors() {
      const select = document.getElementById('remix-source-select');
      if (!select) return;
      const prevVal = select.value;
      select.innerHTML = '';

      libraryTracks.forEach(track => {
        const opt = document.createElement('option');
        opt.value = track.id;
        opt.textContent = `${track.title} (${track.genre} • ${track.bpm} BPM)`;
        select.appendChild(opt);
      });

      if (prevVal && libraryTracks.some(t => t.id === prevVal)) {
        select.value = prevVal;
      }
      loadRemixSourcePreview();
    }

    function loadRemixSourcePreview() {
      const sourceId = document.getElementById('remix-source-select').value;
      const track = libraryTracks.find(t => t.id === sourceId);
      const card = document.getElementById('remix-source-card');
      if (!track || !card) return;

      card.innerHTML = `
        <div class="flex items-center justify-between mb-1">
          <span class="font-bold text-black">Pista Base: ${track.title}</span>
          <span class="font-mono text-[#0284C7] font-bold">${track.genre} • ${track.bpm} BPM</span>
        </div>
        <p class="text-slate-600">Instrumentos originales: ${track.instruments.join(', ')}</p>
      `;
    }

    function generateRemixTrack() {
      const sourceId = document.getElementById('remix-source-select').value;
      const sourceTrack = libraryTracks.find(t => t.id === sourceId);
      if (!sourceTrack) return;

      const targetGenre = document.getElementById('remix-target-genre').value;
      const targetBpm = parseInt(document.getElementById('remix-bpm-slider').value, 10);
      const intensity = document.getElementById('remix-intensity-slider').value;
      const preset = GENRE_PRESETS[targetGenre] || GENRE_PRESETS['Merengue de Calle'];

      const remixTrack = {
        id: 'basa-remix-' + Date.now(),
        title: `${sourceTrack.title} (${targetGenre} Remix)`,
        genre: targetGenre,
        bpm: targetBpm,
        duration: sourceTrack.duration,
        key: sourceTrack.key,
        voice: sourceTrack.voice,
        model: document.getElementById('ai-model-select').value,
        instruments: preset.instruments,
        createdAt: 'Remix • ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        lyrics: `[REMIX ${intensity}% - Fusión ${targetGenre} a ${targetBpm} BPM]\n\n` + sourceTrack.lyrics
      };

      libraryTracks.unshift(remixTrack);
      saveLibraryToStorage();
      renderLibrary();
      selectTrackForPlayer(remixTrack.id, true);
      showToast(`Remix "${remixTrack.title}" creado con éxito.`, 'success');
    }

    /**
     * ============================================================================
     * RENDERIZADO DE BIBLIOTECA Y CARÁTULAS SVG DINÁMICAS
     * ============================================================================
     */
    function generateDynamicCoverSVG(track) {
      const preset = GENRE_PRESETS[track.genre] || { color1: '#0284C7', color2: '#38BDF8' };
      const initials = track.title
        .split(' ')
        .slice(0, 2)
        .map(w => w[0] || '')
        .join('')
        .toUpperCase();

      // Generar barras decorativas deterministas según el ID
      const seed = track.id.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);
      const h1 = 10 + (seed % 16);
      const h2 = 14 + ((seed * 3) % 18);
      const h3 = 8 + ((seed * 7) % 16);

      return `
        <svg viewBox="0 0 64 64" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="grad-${track.id}" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#E0F2FE"/>
              <stop offset="100%" stop-color="${preset.color2}"/>
            </linearGradient>
          </defs>
          <rect width="64" height="64" fill="url(#grad-${track.id})"/>
          <circle cx="50" cy="14" r="16" fill="#FFFFFF" fill-opacity="0.35"/>
          <rect x="10" y="${44 - h1}" width="5" height="${h1}" rx="2.5" fill="${preset.color1}"/>
          <rect x="18" y="${44 - h2}" width="5" height="${h2}" rx="2.5" fill="${preset.color1}"/>
          <rect x="26" y="${44 - h3}" width="5" height="${h3}" rx="2.5" fill="${preset.color1}"/>
          <text x="54" y="54" text-anchor="end" font-family="Inter, sans-serif" font-weight="800" font-size="14" fill="#0F172A">${initials || 'BA'}</text>
        </svg>
      `;
    }

    function renderLibrary() {
      const container = document.getElementById('library-list');
      const query = (document.getElementById('library-search').value || '').toLowerCase().trim();
      container.innerHTML = '';

      const filtered = libraryTracks.filter(t =>
        t.title.toLowerCase().includes(query) ||
        t.genre.toLowerCase().includes(query) ||
        t.instruments.some(i => i.toLowerCase().includes(query))
      );

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 px-4 bg-[#F8FAFC] border border-dashed border-[#CBD5E1] rounded-2xl">
            <p class="text-xs font-bold text-slate-700">No se encontraron pistas con ese filtro.</p>
          </div>
        `;
        return;
      }

      filtered.forEach(track => {
        const isCurrent = track.id === currentTrackId;
        const isTrackPlaying = isCurrent && isPlaying;

        const card = document.createElement('div');
        card.className = isCurrent
          ? 'bg-[#E0F2FE]/55 border-2 border-[#0284C7] rounded-2xl p-3 transition flex flex-col gap-2.5'
          : 'bg-[#F8FAFC] hover:bg-white border border-[#CBD5E1] rounded-2xl p-3 transition flex flex-col gap-2.5';

        card.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="relative w-14 h-14 rounded-xl border border-[#CBD5E1] overflow-hidden shrink-0 group cursor-pointer" onclick="toggleSpecificTrack('${track.id}')">
              ${generateDynamicCoverSVG(track)}
              <div class="absolute inset-0 bg-slate-900/35 flex items-center justify-center opacity-95 group-hover:bg-slate-900/50 transition">
                <i class="fa-solid ${isTrackPlaying ? 'fa-pause' : 'fa-play'} text-white text-sm"></i>
              </div>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-1">
                <h3 class="text-xs sm:text-sm font-extrabold text-black truncate" title="${track.title}">${track.title}</h3>
                <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-white border border-[#CBD5E1] text-slate-700 shrink-0">${track.bpm} BPM</span>
              </div>
              <div class="flex flex-wrap items-center gap-1.5 mt-1">
                <span class="px-2 py-0.5 rounded-md bg-[#E0F2FE] text-[#0284C7] text-[10px] font-bold">${track.genre}</span>
                <span class="text-[11px] text-slate-600 font-medium">${formatSeconds(track.duration)} • ${track.key}</span>
              </div>
              <p class="text-[10px] text-slate-500 truncate mt-1">${track.instruments.join(' • ')}</p>
            </div>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-[#E2E8F0] gap-1.5">
            <button onclick="openLyricsModal('${track.id}')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-bold text-black transition cursor-pointer flex items-center gap-1">
              <i class="fa-solid fa-file-lines text-[#0284C7]"></i> Letra
            </button>
            <button onclick="sendTrackToRemix('${track.id}')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-bold text-black transition cursor-pointer flex items-center gap-1">
              <i class="fa-solid fa-shuffle text-[#0284C7]"></i> Remix
            </button>
            <button onclick="downloadTrackWAVById('${track.id}')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-[#E0F2FE] border border-[#CBD5E1] text-[11px] font-bold text-[#0284C7] transition cursor-pointer flex items-center gap-1">
              <i class="fa-solid fa-download"></i> WAV
            </button>
            <button onclick="deleteTrack('${track.id}')" title="Eliminar pista" class="px-2 py-1 rounded-lg hover:bg-red-50 text-slate-500 hover:text-red-600 text-[11px] transition cursor-pointer">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
