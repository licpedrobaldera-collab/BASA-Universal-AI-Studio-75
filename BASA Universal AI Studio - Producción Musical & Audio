     * ============================================================================
     */
    function switchWorkspaceTab(tabName) {
      // Actualizar botones laterales
      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.remove('bg-[#E0F2FE]', 'text-[#0284C7]', 'border', 'border-[#BAE6FD]', 'font-bold');
        btn.classList.add('text-slate-700', 'font-semibold');
        const icon = btn.querySelector('i');
        if (icon) {
          icon.classList.remove('text-[#0284C7]');
          icon.classList.add('text-slate-500');
        }
      });

      const activeBtn = document.getElementById(`nav-${tabName}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-[#E0F2FE]', 'text-[#0284C7]', 'border', 'border-[#BAE6FD]', 'font-bold');
        activeBtn.classList.remove('text-slate-700', 'font-semibold');
        const icon = activeBtn.querySelector('i');
        if (icon) {
          icon.classList.add('text-[#0284C7]');
          icon.classList.remove('text-slate-500');
        }
      }

      // En móvil/tablet, si pulsa Biblioteca BASA, hacer scroll suave al panel derecho
      if (tabName === 'library') {
        document.getElementById('library-panel').scrollIntoView({ behavior: 'smooth' });
        return;
      }

      // Mostrar vista correspondiente en el panel central
      document.querySelectorAll('.workspace-view').forEach(view => view.classList.add('hidden'));
      const targetView = document.getElementById(`view-${tabName}`);
      if (targetView) {
        targetView.classList.remove('hidden');
        targetView.classList.add('flex');
      }
    }

    function setCreationMode(mode) {
      // Actualizar pestañas Agent / Custom / Remix
